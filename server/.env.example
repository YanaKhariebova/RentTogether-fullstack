PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rent_together?schema=public"
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SEED_OWNER_CLERK_ID=
SEED_RENTER_CLERK_ID=
# local for development; cloudinary for the agreed cloud provider.
IMAGE_STORAGE=local
IMAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads/

# Set IMAGE_STORAGE=cloudinary after adding credentials from the shared account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Separate namespaces can be used for each developer.
CLOUDINARY_FOLDER=renttogether/items
