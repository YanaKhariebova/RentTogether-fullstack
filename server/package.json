{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include \"src/**/*.ts\" --include .env --exclude \"src/generated/**\" --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "lint": "eslint . --config ../eslint.config.js",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:local": "node scripts/local-db.mjs",
    "db:check": "prisma generate && node scripts/local-db.mjs --check",
    "test:db": "tsx --test --test-concurrency=1 tests/database.integration.ts tests/items.database.integration.ts tests/messages.database.integration.ts",
    "storage:check": "tsx src/scripts/checkImageStorage.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/express": "^2.1.84",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
