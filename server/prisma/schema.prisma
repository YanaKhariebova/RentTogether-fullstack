generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique
  name        String
  city        String   @default("")
  email       String
  phone       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]
  rentals     Booking[] @relation("RenterBookings")
}

model Category {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  items Item[]
}

model Item {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @db.Uuid
  categoryId  String      @db.Uuid
  title       String      @db.VarChar(100)
  description String
  pricePerDay Decimal     @db.Decimal(8, 2)
  city        String      @db.VarChar(100)
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ItemImage[]
  bookings    Booking[]

  @@index([ownerId, createdAt, id])
  @@index([isPublished, createdAt, id])
  @@index([categoryId])
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}

model Booking {
  id                  String        @id @default(uuid()) @db.Uuid
  itemId              String        @db.Uuid
  renterId            String        @db.Uuid
  pickupDate          DateTime      @db.Date
  returnDate          DateTime      @db.Date
  status              BookingStatus @default(PENDING)
  pricePerDaySnapshot Decimal       @db.Decimal(8, 2)
  totalPrice          Decimal       @db.Decimal(10, 2)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  item                Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  renter              User          @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Restrict)

  @@index([renterId, createdAt, id])
  @@index([itemId, status, pickupDate, returnDate])
}

model ItemImage {
  id         String  @id @default(uuid()) @db.Uuid
  itemId     String  @db.Uuid
  url        String
  // Ключ объекта для будущего удаления из хранилища; в публичный DTO не входит.
  storageKey String?
  order      Int     @default(0)
  item       Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, order])
}

// Удаление файла повторяется после сбоя хранилища, даже если фото уже убрано из item.
model ImageCleanup {
  storageKey String   @id
  createdAt  DateTime @default(now())
}
