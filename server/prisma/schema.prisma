generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  clerkUserId   String         @unique
  name          String
  city          String         @default("")
  email         String
  phone         String         @default("")
  avatarUrl     String         @default("")
  preferredLocale String?
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         Item[]
  rentals       Booking[]      @relation("RenterBookings")
  favorites     Favorite[]
  messages      Message[]
  notifications Notification[]
  inquiries     Conversation[] @relation("InquiryParticipant")
  hiddenConversations HiddenConversation[]
  itemReports   ItemReport[]
}

model Category {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  items Item[]
}

model Item {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @db.Uuid
  categoryId  String      @db.Uuid
  title       String      @db.VarChar(100)
  description String
  pricePerDay Decimal     @db.Decimal(8, 2)
  city        String      @db.VarChar(100)
  isPublished Boolean     @default(false)
  moderationRemovedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ItemImage[]
  bookings    Booking[]
  favorites   Favorite[]
  conversations Conversation[]
  reports       ItemReport[]

  @@index([ownerId, createdAt, id])
  @@index([isPublished, createdAt, id])
  @@index([moderationRemovedAt])
  @@index([categoryId])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

model ItemReport {
  id         String       @id @default(uuid()) @db.Uuid
  itemId     String       @db.Uuid
  reporterId String       @db.Uuid
  reason     String       @db.VarChar(80)
  details    String       @default("") @db.VarChar(500)
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  item       Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([itemId, reporterId])
  @@index([status, createdAt])
  @@index([itemId])
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}

model Booking {
  id                  String         @id @default(uuid()) @db.Uuid
  itemId              String         @db.Uuid
  renterId            String         @db.Uuid
  pickupDate          DateTime       @db.Date
  returnDate          DateTime       @db.Date
  status              BookingStatus  @default(PENDING)
  pricePerDaySnapshot Decimal        @db.Decimal(8, 2)
  totalPrice          Decimal        @db.Decimal(10, 2)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  item                Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  renter              User           @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Restrict)
  renterArchivedAt    DateTime?
  ownerArchivedAt     DateTime?
  conversation        Conversation?
  notifications       Notification[]

  @@index([renterId, createdAt, id])
  @@index([itemId, status, pickupDate, returnDate])
}

model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  kind          ConversationKind @default(BOOKING)
  bookingId     String?          @unique @db.Uuid
  itemId        String           @db.Uuid
  participantId String?          @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  booking       Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item          Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participant   User?            @relation("InquiryParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  messages      Message[]
  hiddenBy      HiddenConversation[]

  @@index([updatedAt, id])
  @@unique([itemId, participantId])
}

enum ConversationKind {
  BOOKING
  ITEM_INQUIRY
}

model HiddenConversation {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  hiddenAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, hiddenAt])
}

model Message {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  senderId         String       @db.Uuid
  replyToMessageId String?      @db.Uuid
  body             String       @db.VarChar(2000)
  createdAt        DateTime     @default(now())
  readAt           DateTime?
  editedAt         DateTime?
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo          Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]    @relation("MessageReplies")

  @@index([conversationId, createdAt, id])
  @@index([conversationId, readAt])
}

enum NotificationType {
  BOOKING_REQUEST_CREATED
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_ACTIVE
  BOOKING_COMPLETED
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  bookingId String           @db.Uuid
  type      NotificationType
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId, type])
  @@index([userId, createdAt, id])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  itemId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, createdAt, id])
}

model ItemImage {
  id         String  @id @default(uuid()) @db.Uuid
  itemId     String  @db.Uuid
  url        String
  // Ключ объекта для будущего удаления из хранилища; в публичный DTO не входит.
  storageKey String?
  order      Int     @default(0)
  item       Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, order])
}

// Удаление файла повторяется после сбоя хранилища, даже если фото уже убрано из item.
model ImageCleanup {
  storageKey String   @id
  createdAt  DateTime @default(now())
}
